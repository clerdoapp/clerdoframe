  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "app.clerdo.clerdoframe",
    "productName": "ClerdoFrame",
    "directories": {
      "output": "release",
      "buildResources": "brand/build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pptx",
        "name": "Presentation",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": "ppsx",
        "name": "Slide show",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.slideshow"
      },
      {
        "ext": "potx",
        "name": "Presentation template",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.template"
      },
      {
        "ext": "pptm",
        "name": "Presentation",
        "role": "Editor",
        "mimeType": "application/vnd.ms-powerpoint.presentation.macroEnabled.12"
      },
      {
        "ext": "odp",
        "name": "OpenDocument presentation",
        "role": "Editor",
        "mimeType": "application/vnd.oasis.opendocument.presentation"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/app-icon/clerdoframe.icns"
    },
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon/clerdoframe.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "Clerdo",
      "icon": "assets/app-icon/clerdoframe-1024.png",
      "synopsis": "Free, open-source presentation app",
      "description": "Design slides, animate them and present. Opens and saves .pptx.",
      "desktop": {
        "Name": "ClerdoFrame",
        "GenericName": "Presentation",
        "Comment": "Design and present slides",
        "Keywords": "presentation;slides;pptx;slideshow;deck;",
        "StartupWMClass": "ClerdoFrame"
      }
    },
    "artifactName": "clerdoframe-${version}-${os}-${arch}.${ext}",
    "deb": {
      "artifactName": "clerdoframe-${version}-linux-amd64.deb"
    },
    "rpm": {
      "artifactName": "clerdoframe-${version}-linux-x86_64.rpm"
    },
    "publish": []
  },
  "homepage": "https://clerdo.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/clerdoapp/clerdoframe.git"
  },
  "engines": {
    "node": ">=20"
  }
}
